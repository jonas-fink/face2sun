{
    "compilerOptions": {
        "target": "es2022",
        "lib": ["es2022"],
        "module": "preserve",
        "moduleDetection": "force",
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "erasableSyntaxOnly": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "rootDir": "./src",
        "outDir": "./dist"
    },
    "include": ["src"]
}
